# Contact form delivery endpoint
#
# The site builds as static HTML, so the contact form needs a server-side
# endpoint to deliver mail. A Cloudflare Pages Function is committed at
# functions/api/contact.ts; it sends through Resend and delivers to CONTACT_TO.
#
# Set this to /api/contact once the deployment actually serves that path
# (Cloudflare Pages runs the functions/ directory; a plain Worker with static
# assets ignores it). While this is empty the form falls back to a mailto:
# action, so a message is never silently swallowed and never posts to a 404.
PUBLIC_CONTACT_FORM_ENDPOINT=""

# Mail delivery for the contact form (server-side only)
#
# These are read by the Pages Function, never by the browser - note the absence
# of the PUBLIC_ prefix, which is what keeps them out of the client bundle. In
# production set them in the Cloudflare dashboard (Settings > Environment
# variables), with RESEND_API_KEY marked as a Secret. Never commit a real key.
#
#   1. Sign up at https://resend.com
#   2. Add the domain pejdo.com and create the SPF/DKIM DNS records it gives you.
#      Without verification Resend rejects the send with a 403.
#   3. Create an API key and set RESEND_API_KEY to it.
#
# CONTACT_FROM must be on the verified domain. The visitor's own address goes
# into Reply-To, so replying from your inbox reaches them directly.
RESEND_API_KEY=""
CONTACT_TO="nikola@pejdo.com"
CONTACT_FROM="web@pejdo.com"

# Optional: rate limiting
#
# Bind a KV namespace named CONTACT_RATELIMIT in the Pages project to cap
# submissions at 5 per IP per hour. Without the binding the form still works,
# just without limiting. This is a binding, not a variable - nothing to set here.

# Google Photos album for /fotos
#
# The slideshow reads a PUBLICLY SHARED Google Photos album at build time.
#   1. Open the album in Google Photos
#   2. Share -> Create link (so "anyone with the link" can view it)
#   3. Paste the link below, then rebuild
#
# Anything the link can reach becomes public on your site - only use albums you
# are happy to publish.
#
# Note: this reads the public share page, not the official API. Google restricted
# the Library API's readonly scope in March 2025, so a static site can no longer
# read albums it did not create, and the Picker API needs a per-visitor sign-in.
# If Google changes the share page, the build logs a warning and /fotos falls
# back to the local photo list in src/pages/fotos.astro.
#
# New uploads appear only after a rebuild.
PUBLIC_GOOGLE_PHOTOS_ALBUM_URL=""

# Vimeo video shown on /video
#
# Metadata (title, poster image, duration) is read from Vimeo's public oEmbed
# endpoint at build time. No API key or OAuth is needed, but the video must be
# public, or unlisted with its hash included in the link.
#
# Accepted shapes:
#   https://vimeo.com/123456789
#   https://vimeo.com/123456789/abcdef1234    (unlisted, hash in the path)
#   https://vimeo.com/123456789?h=abcdef1234  (unlisted, hash as a parameter)
#
# Leave empty to use the placeholder example, or edit the list directly in
# src/pages/video.astro to show several videos.
#
# The player itself is only loaded after the visitor clicks play, so nothing is
# sent to Vimeo for visitors who never start the video.
PUBLIC_VIMEO_VIDEO_URL=""
