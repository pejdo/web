---
/**
 * Logo Component
 *
 * PEJDO.COM brand logo. Uses the horizontal lockup (mark + wordmark) by
 * default and the standalone mark when showText is false.
 * Light mode uses the blue variant, dark mode the white variant.
 * Used consistently across Header, Footer, and Auth layouts.
 *
 * @example
 * ```astro
 * <Logo />
 * <Logo showText={false} />
 * <Logo size="lg" />
 * ```
 */
interface Props {
  /** Show the wordmark next to the mark */
  showText?: boolean;
  /** Size variant */
  size?: 'sm' | 'md' | 'lg';
  /** Additional CSS classes */
  class?: string;
}

const { showText = true, size = 'md', class: className = '' } = Astro.props;

const sizeClasses = {
  sm: 'h-5',
  md: 'h-6',
  lg: 'h-8',
};

const lightSrc = showText ? '/logo.png' : '/logo-mark.png';
const darkSrc = showText ? '/logo-white.png' : '/logo-mark-white.png';

// Intrinsic dimensions of the exported assets (used to avoid layout shift)
const intrinsic = showText ? { width: 714, height: 160 } : { width: 186, height: 160 };
---

<a href="/" class:list={['flex items-center', className]} aria-label="PEJDO.COM home">
  <img
    src={lightSrc}
    width={intrinsic.width}
    height={intrinsic.height}
    alt="PEJDO.COM"
    class:list={[sizeClasses[size], 'w-auto dark:hidden']}
    loading="eager"
    decoding="async"
  />
  <img
    src={darkSrc}
    width={intrinsic.width}
    height={intrinsic.height}
    alt="PEJDO.COM"
    class:list={[sizeClasses[size], 'w-auto hidden dark:block']}
    loading="eager"
    decoding="async"
  />
</a>
