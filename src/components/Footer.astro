---
/**
 * Footer Component
 *
 * Unified footer with boxed and fullWidth variants.
 * Contains the brand blurb and copyright.
 *
 * @example
 * ```astro
 * <Footer />
 * <Footer variant="fullWidth" />
 * ```
 */
import Logo from './Logo.astro';

interface Props {
  /** Layout variant - boxed (default) or fullWidth */
  variant?: 'boxed' | 'fullWidth';
}

const { variant = 'boxed' } = Astro.props;

/**
 * The footer no longer carries navigation: every page is reachable from the
 * header, so duplicating the list here only added height. What remains is the
 * brand blurb.
 */
const containerClass =
  variant === 'fullWidth' ? 'w-full px-4' : 'container max-w-5xl mx-auto px-4 sm:px-6';
---

<footer class="border-t bg-background">
  <div class:list={[containerClass, 'py-8 md:py-12']}>
    <!-- Brand -->
    <div>
      <Logo />
      <p class="mt-3 md:mt-4 text-sm text-muted-foreground">
        Obitelj Pejdo — hrvatski rod iz Blizanaca, općina Čitluk, na hercegovačkom Brotnju. Zapisi o
        rodnom kraju, tradiciji i obiteljskoj povijesti.
      </p>
    </div>

    <!-- Copyright -->
    <div class="mt-6 border-t pt-6 md:mt-8 md:pt-8 text-center text-sm text-muted-foreground">
      <p>&copy; {new Date().getFullYear()} Nikola Pejdo</p>
    </div>
  </div>
</footer>
