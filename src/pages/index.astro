---
import BaseLayout from '@/layouts/BaseLayout.astro';

/*
 * OBITELJ PEJDO — naslovna stranica
 *
 * VAŽNO ZA DOPUNU:
 * Opisi Hercegovine i Brotnja općeniti su i provjerljivi. Konkretni
 * obiteljski podaci (imena predaka, godine, priče) NISU izmišljeni —
 * upisuju se u `obiteljskiZapisi` kako se prikupe.
 */

// Rodno mjesto
const rodnoMjesto = {
  selo: 'Blizanci',
  opcina: 'Čitluk',
  kraj: 'Brotnjo',
  zupanija: 'Hercegovina, Bosna i Hercegovina',
};

// Kraj i obicaji — opci, provjerljivi opis hercegovackog podneblja
const kraj = [
  {
    naslov: 'Brotnjo',
    tekst:
      'Blizanci leže na Brotnju, kamenoj visoravni između Neretve i Mostarskog blata, u općini Čitluk. Visoravan je poznata po vinogradima i po tome što se zemlja tu osvaja od kamena, parcelu po parcelu.',
  },
  {
    naslov: 'Kamen',
    tekst:
      'Hercegovina je zemlja krša — bijelog vapnenca koji izlazi na površinu gdje god zemlja nije obrađena. Kuće, ograde i suhozidi stoljećima se grade od onoga što je pod nogama, bez veziva, kamen na kamen.',
  },
  {
    naslov: 'Vino',
    tekst:
      'Brotnjo je vinogradarski kraj s autohtonim sortama — žilavkom među bijelim i blatinom među crnim vinima. Domaći podrum i vlastita loza dio su svakodnevice, ne turističkog ukrasa.',
  },
  {
    naslov: 'Sunce i voda',
    tekst:
      'Ljeta su duga i vruća, a voda dragocjena. Na kamenim visoravnima uz lozu rastu smokve, šipak i tabak, a bura i sunce oblikuju i zemlju i ljude.',
  },
  {
    naslov: 'Vjera',
    tekst:
      'Hrvati u Hercegovini pripadaju Katoličkoj crkvi, a franjevci su stoljećima nosili župe, škole i pismenost kroz razdoblja u kojima drugih ustanova nije bilo. Crkveni kalendar i danas označava godinu.',
  },
  {
    naslov: 'Rod i kuća',
    tekst:
      'Rodbinske veze idu široko — braća, sestre, stričevi, ujaci i kumovi drže obitelj povezanom i kad se raseli. Kuća se ne prodaje lako; ostaje mjesto na koje se vraća.',
  },
  {
    naslov: 'Put u svijet',
    tekst:
      'Iz Hercegovine se stoljećima odlazilo na rad — u Njemačku, Austriju, Švicarsku, a prije toga preko oceana u Ameriku, Kanadu i Australiju. Malo je obitelji bez rodbine u dijaspori.',
  },
];

/*
 * OBITELJSKI ZAPISI
 *
 * Rodno mjesto je poznato i upisano. Ostalo (najstariji poznati predak,
 * godine, grane obitelji) upisuje se kako se prikupi iz župnih knjiga i
 * obiteljskog pamćenja. Ne upisujem podatke koje nemam.
 */
const obiteljskiZapisi: Array<{ naslov: string; tekst: string }> = [
  {
    naslov: 'Rodno mjesto',
    tekst: `${rodnoMjesto.selo}, općina ${rodnoMjesto.opcina} — na Brotnju, u Hercegovini.`,
  },
];
---

<BaseLayout
  title="Obitelj Pejdo"
  description="Obitelj Pejdo — hrvatski rod iz Blizanaca, općina Čitluk, na hercegovačkom Brotnju. Zapisi o rodnom kraju, tradiciji i obiteljskoj povijesti."
>
  {/* ===== Hero ===== */}
  <section class="section-kamen relative overflow-hidden">
    <div class="sahovnica-band" aria-hidden="true"></div>

    <div class="container max-w-5xl mx-auto px-6 py-20 md:py-28" data-animate="fade">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-terakota">
        Blizanci <span aria-hidden="true">·</span> Čitluk <span aria-hidden="true">·</span> Brotnjo
      </p>

      <h1
        class="font-serif-display mt-6 text-5xl leading-[1.05] md:text-7xl lg:text-8xl max-w-4xl text-balance"
      >
        Pejdo
      </h1>

      <div class="pleter-rule mt-8 max-w-xs" aria-hidden="true"></div>

      <p class="mt-8 max-w-2xl text-lg md:text-xl leading-relaxed">
        Hrvatski rod iz Blizanaca u općini Čitluk, na hercegovačkom Brotnju — kraju kamena, sunca i
        loze. Ova stranica čuva zapise o rodnom mjestu, običajima i ljudima koji nose ime Pejdo, u
        domovini i u dijaspori.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row gap-4">
        <a
          href="#kraj"
          class="inline-flex items-center justify-center whitespace-nowrap rounded-md bg-terakota text-terakota-foreground text-base font-semibold h-12 px-10 transition-transform duration-300 hover:scale-105 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
        >
          O kraju
        </a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center whitespace-nowrap rounded-md border border-input bg-background text-sm font-medium h-12 px-8 transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
        >
          Javite se
        </a>
      </div>
    </div>

    <div class="sahovnica-band" aria-hidden="true"></div>
  </section>

  {/* ===== Uvod ===== */}
  <section class="py-16 md:py-24">
    <div class="container max-w-3xl mx-auto px-6" data-animate="fade">
      <h2 class="font-serif-display text-3xl md:text-4xl">Ime i podrijetlo</h2>
      <div class="pleter-rule mt-5 max-w-[10rem]" aria-hidden="true"></div>

      <p class="pocetno-slovo mt-8 text-lg leading-relaxed text-foreground">
        Pejdo je obiteljsko ime koje nose Hrvati iz Blizanaca, sela u općini Čitluk na Brotnju —
        kamenoj visoravni između Neretve i Mostarskog blata. Kao i mnoga hercegovačka obiteljska
        imena, prenosilo se usmeno kroz naraštaje prije nego što je zapisano u matične knjige koje
        su vodile župe.
      </p>

      <p class="mt-6 text-lg leading-relaxed text-muted-foreground">
        Povijest jedne obitelji ne stoji u knjigama nego u ljudima — u tome gdje je čija kuća, koja
        je loza čija, kome se ide na slavu i koga se spominje na Svi svete. Dio toga zapisan je u
        župnim knjigama, dio postoji samo dok ga se prenosi dalje.
      </p>

      <p class="mt-6 text-lg leading-relaxed text-muted-foreground">
        Ova stranica postoji da se taj drugi dio ne izgubi. Ako imate podatke, fotografije ili priče
        iz obitelji, dobro su došli — svaki zapis nadopunjuje sliku.
      </p>
    </div>
  </section>

  {/* ===== Kraj i obicaji ===== */}
  <section id="kraj" class="section-kamen py-16 md:py-24 scroll-mt-16">
    <div class="container max-w-5xl mx-auto px-6">
      <div class="max-w-2xl">
        <h2 class="font-serif-display text-3xl md:text-4xl">Kraj i običaji</h2>
        <div class="pleter-rule mt-5 max-w-[10rem]" aria-hidden="true"></div>
        <p class="mt-6 text-lg leading-relaxed">
          Hercegovina oblikuje one koji iz nje dolaze. Ovo je kratak opis podneblja i načina života
          koji stoji u pozadini svake hercegovačke obiteljske priče.
        </p>
      </div>

      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3 mt-12" data-animate="fade">
        {
          kraj.map((blok) => (
            <article class="border-l-2 border-terakota pl-6">
              <h3 class="font-serif-display text-2xl">{blok.naslov}</h3>
              <p class="mt-3 leading-relaxed">{blok.tekst}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <div class="sahovnica-band" aria-hidden="true"></div>

  {/* ===== Obiteljski zapisi ===== */}
  <section class="py-16 md:py-24">
    <div class="container max-w-3xl mx-auto px-6" data-animate="fade">
      <h2 class="font-serif-display text-3xl md:text-4xl">Obiteljski zapisi</h2>
      <div class="pleter-rule mt-5 max-w-[10rem]" aria-hidden="true"></div>

      {
        obiteljskiZapisi.length > 0 && (
          <dl class="mt-8 space-y-6">
            {obiteljskiZapisi.map((zapis) => (
              <div class="border-l-2 border-terakota pl-6">
                <dt class="font-serif-display text-xl">{zapis.naslov}</dt>
                <dd class="mt-2 leading-relaxed text-muted-foreground">{zapis.tekst}</dd>
              </div>
            ))}
          </dl>
        )
      }

      <div class="mt-8 rounded-lg border border-dashed bg-muted/40 p-6 md:p-8">
        <p class="leading-relaxed text-muted-foreground">
          Zapisi o najstarijim poznatim precima i granama obitelji upisuju se kako se prikupe iz
          župnih knjiga i obiteljskog pamćenja.
        </p>
        <p class="mt-4 leading-relaxed text-muted-foreground">
          Imate podatak, fotografiju ili priču?{' '}
          <a
            href="/contact"
            class="font-medium text-foreground underline decoration-terakota decoration-2 underline-offset-4 hover:text-terakota transition-colors"
          >
            Javite se
          </a>{' '}
          i bit će uvršteno.
        </p>
      </div>
    </div>
  </section>

  {/* ===== Zavrsni poziv ===== */}
  <section class="section-inverted">
    <div class="sahovnica-band" aria-hidden="true"></div>
    <div class="py-20 md:py-28 px-6">
      <div class="container max-w-3xl mx-auto text-center" data-animate="scale">
        <h2 class="font-serif-display text-3xl md:text-5xl">Nosite li i vi ime Pejdo?</h2>
        <p class="mt-6 text-lg text-muted-foreground max-w-xl mx-auto leading-relaxed">
          Rod je razgranat i raseljen. Ako znate dio priče — iz Hercegovine ili iz dijaspore —
          javite se i dopunimo zapis zajedno.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 mt-10 justify-center">
          <a
            href="/contact"
            class="inline-flex items-center justify-center whitespace-nowrap rounded-md bg-terakota text-terakota-foreground text-base font-semibold h-12 px-10 transition-transform duration-300 hover:scale-105 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
          >
            Javite se
          </a>
          <a
            href="mailto:nikola@pejdo.com"
            class="inline-flex items-center justify-center whitespace-nowrap rounded-md border border-input bg-background text-sm font-medium h-12 px-8 transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
          >
            nikola@pejdo.com
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
